{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"<HOOK_KIT_DIR>/hooks/inject-rules.mjs\" --codex",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"<HOOK_KIT_DIR>/hooks/inject-rules.mjs\" --codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|exec_command|shell_command|shell)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"<HOOK_KIT_DIR>/hooks/deploy-gate.mjs\" --codex",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"<HOOK_KIT_DIR>/hooks/db-write-guard.mjs\" --codex",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(apply_patch|Write|Edit|Bash|PowerShell|exec_command|shell_command|shell)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"<HOOK_KIT_DIR>/hooks/walk-brief-guard.mjs\" --codex",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"<HOOK_KIT_DIR>/hooks/read-ledger-gate.mjs\" --codex",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"<HOOK_KIT_DIR>/hooks/no-idle.mjs\" --codex",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"<HOOK_KIT_DIR>/hooks/double-check.mjs\" --codex",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"<HOOK_KIT_DIR>/hooks/measure-gate.mjs\" --codex",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"<HOOK_KIT_DIR>/hooks/completion-gate.mjs\" --codex",
            "timeout": 65
          },
          {
            "type": "command",
            "command": "node \"<HOOK_KIT_DIR>/hooks/wake.mjs\" --codex",
            "timeout": 1800,
            "async": true
          }
        ]
      }
    ]
  }
}
